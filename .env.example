# .env.examples

# Local development
DJANGO_SETTINGS_MODULE=VotingSphere.settings.dev
SECRET_KEY=change-me
DEBUG=True

# Allowed hosts for dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (dev). If you prefer a single URL, comment these and use DATABASE_URL instead.
DB_NAME=votingsphere_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/votingsphere_db

# CORS/CSRF for your local web UI (Vite 5173, CRA 3000)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Channels (optional for websockets; leave unset to use in-memory in dev)
# REDIS_URL=redis://127.0.0.1:6379/0

# JWT lifetimes for dev (your dev.py reads these)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
